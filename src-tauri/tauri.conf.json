{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vértice",
  "version": "0.1.0",
  "identifier": "app.vertice.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vértice",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "Utility",
    "publisher": "Ricky06202",
    "copyright": "© 2026 Ricky06202 — GPL-3.0-or-later",
    "shortDescription": "Programa libre de topografía",
    "longDescription": "Vértice: registro de puntos, TR/IN/GT, áreas de poligonal e informes, en un solo archivo .vertice. 100% offline, GPL-3.0-or-later.",
    "fileAssociations": [
      {
        "ext": ["vertice"],
        "mimeType": "application/vertice",
        "description": "Proyecto Vértice",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
